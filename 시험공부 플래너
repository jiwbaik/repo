def add_subject():
    name = subject_entry_var.get().strip()
    if name and name != "과목명 입력 (예: 수학, 영어)":
        subjects.append({
            "id": str(datetime.now().timestamp()),
            "name": name,
            "isWeak": False,
            "isFocus": False,
            "customWeight": 0,
        })
        subject_entry.delete(0, "end")
        render_subjects()
 
subject_entry.bind("<Return>", lambda e: add_subject())
 
