def render_scores():
    for w in score_inner.winfo_children():
        w.destroy()
 
    if not scores:
        return
 
    score_placeholder.pack_forget()
    info_frame.pack(fill="x", padx=16, pady=(0, 16))
    score_inner.pack(fill="x", padx=16, pady=(0, 16))
 
    for sc in scores:
        row_f = tk.Frame(score_inner, bg="white")
        row_f.pack(fill="x", pady=4)
 
        tk.Label(row_f, text=f"■", font=("맑은 고딕", 12),
                 bg="white", fg=sc["color"]).pack(side="left")
        tk.Label(row_f, text=f" {sc['name']}",
                 font=("맑은 고딕", 10, "bold"), bg="white", fg="#1f2937"
                 ).pack(side="left")
        tk.Label(row_f, text=f"{sc['percentage']:.1f}%  (점수: {sc['score']}점)",
                 font=("맑은 고딕", 9), bg="white", fg="#6b7280"
                 ).pack(side="right")
 
        bar_bg = tk.Frame(score_inner, bg="#e5e7eb", height=8)
        bar_bg.pack(fill="x", pady=(0, 6))
        bar_bg.update_idletasks()
 
        bar_w = int(bar_bg.winfo_width() * sc["percentage"] / 100)
        bar = tk.Frame(bar_bg, bg=sc["color"], height=8, width=max(bar_w, 4))
        bar.place(x=0, y=0, relheight=1, relwidth=sc["percentage"]/100)
 
