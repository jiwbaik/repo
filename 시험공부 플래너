def render_calendar():
    for w in cal_grid_frame.winfo_children():
        w.destroy()
 
    y = cal_year_var.get()
    m = cal_month_var.get()
    cal_label_var.set(f"{y}년 {m}월")
 
    for i, d in enumerate(WEEKDAYS):
        color = "#ef4444" if i == 0 else "#374151"
        tk.Label(cal_grid_frame, text=d, font=("맑은 고딕", 10, "bold"),
                 bg="white", fg=color, width=7).grid(row=0, column=i, pady=4)
 
    first_weekday = calendar.monthrange(y, m)[0]
    first_weekday = (first_weekday + 1) % 7  # 월요일=0 → 일요일=0 으로
    days_in_month = calendar.monthrange(y, m)[1]
    today = date.today()
 
    col, row = first_weekday, 1
    for day_num in range(1, days_in_month + 1):
        d_obj = date(y, m, day_num)
        d_str = d_obj.isoformat()
 
        sessions_today = [s for s in study_sessions if s["date"] == d_str]
        total_min = sum(s["duration"] for s in sessions_today)
 
        is_today    = (d_obj == today)
        is_selected = (selected_date_var.get() == d_str)
 
        bg = "#eef2ff" if is_selected else ("#fef9c3" if is_today else "white")
        border_color = "#4f46e5" if is_selected else ("#f59e0b" if is_today else "#e5e7eb")
 
        cell = tk.Frame(cal_grid_frame, bg=bg, width=90, height=72,
                        highlightthickness=1, highlightbackground=border_color)
        cell.grid(row=row, column=col, padx=2, pady=2, sticky="nsew")
        cell.grid_propagate(False)
 
        num_color = "#2563eb" if is_today else "#374151"
        tk.Label(cell, text=str(day_num), font=("맑은 고딕", 9, "bold"),
                 bg=bg, fg=num_color).pack(anchor="nw", padx=4, pady=2)
 
        for s in sessions_today[:2]:
            c = s.get("color", "#3b82f6")
            tk.Label(cell, text=s["subjectName"],
                     font=("맑은 고딕", 7), bg=c+"33", fg=c,
                     relief="flat").pack(fill="x", padx=2)
 
        if total_min > 0:
            tk.Label(cell, text=f"⏱ {total_min//60}h{total_min%60:02d}m",
                     font=("맑은 고딕", 7), bg=bg, fg="#6b7280").pack(anchor="sw", padx=2)
 
        def on_click(e, ds=d_str):
            selected_date_var.set(ds)
            render_calendar()
            render_session_detail()
 
        cell.bind("<Button-1>", on_click)
        for child in cell.winfo_children():
            child.bind("<Button-1>", on_click)
 
        col += 1
        if col == 7:
            col = 0
            row += 1
 
tk.Button(nav_frame, text="◀", font=("맑은 고딕", 12),
          bg="white", fg="#374151", relief="flat", cursor="hand2",
          command=lambda: (
              cal_month_var.set(cal_month_var.get() - 1) if cal_month_var.get() > 1
              else (cal_year_var.set(cal_year_var.get() - 1), cal_month_var.set(12)),
              render_calendar()
          )).pack(side="left", padx=8)
 
tk.Label(nav_frame, textvariable=cal_label_var,
