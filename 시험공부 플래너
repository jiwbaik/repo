def render_session_detail():
    for w in session_detail_frame.winfo_children():
        w.destroy()
    for w in add_session_frame.winfo_children():
        w.destroy()
 
    ds = selected_date_var.get()
    if not ds:
        return
 
    tk.Label(session_detail_frame,
             text=f"📅 {ds} 학습 기록",
             font=("맑은 고딕", 12, "bold"), bg="white", fg="#1f2937"
             ).pack(anchor="w", pady=(8, 4))
 
    sessions_today = [s for s in study_sessions if s["date"] == ds]
 
    for s in sessions_today:
        row_f = tk.Frame(session_detail_frame, bg=s.get("color","#3b82f6")+"18",
                         relief="flat")
        row_f.pack(fill="x", pady=2, padx=4)
        tk.Label(row_f, text=f"● {s['subjectName']}  {s['duration']}분",
                 font=("맑은 고딕", 10), bg=row_f["bg"], fg="#1f2937"
                 ).pack(side="left", padx=10, pady=6)
 
        def make_remove(sid=s["id"]):
            def remove():
                study_sessions[:] = [x for x in study_sessions if x["id"] != sid]
                render_calendar()
                render_session_detail()
            return remove
 
        tk.Button(row_f, text="✕", font=("맑은 고딕", 9),
                  bg=row_f["bg"], fg="#ef4444", relief="flat",
                  cursor="hand2", command=make_remove()
                  ).pack(side="right", padx=8)
 
    # 추가 버튼 또는 폼
    if not scores:
        tk.Label(session_detail_frame,
                 text="먼저 우선순위를 계산해주세요",
                 font=("맑은 고딕", 10), bg="white", fg="#9ca3af"
                 ).pack(pady=6)
        return
 
    def show_add_form():
        add_session_frame.pack(fill="x", padx=16, pady=(0, 12))
        for w in add_session_frame.winfo_children():
            w.destroy()
 
        form = tk.Frame(add_session_frame, bg="#f9fafb",
                        highlightthickness=1, highlightbackground="#d1d5db")
        form.pack(fill="x", pady=4)
 
        # 과목 선택
        tk.Label(form, text="과목 선택", font=("맑은 고딕", 10),
                 bg="#f9fafb", fg="#374151").pack(anchor="w", padx=12, pady=(10, 2))
 
        subject_names = [s["name"] for s in subjects]
        sel_subject_var = tk.StringVar(value=subject_names[0] if subject_names else "")
 
        subject_combo = ttk.Combobox(form, textvariable=sel_subject_var,
                                     values=subject_names, state="readonly",
                                     font=("맑은 고딕", 10))
        subject_combo.pack(fill="x", padx=12, pady=(0, 8))
 
        # 시간 입력
        tk.Label(form, text="학습 시간 (분)", font=("맑은 고딕", 10),
                 bg="#f9fafb", fg="#374151").pack(anchor="w", padx=12)
 
        dur_frame = tk.Frame(form, bg="#f9fafb")
        dur_frame.pack(fill="x", padx=12, pady=(2, 10))
 
        dur_var = tk.StringVar(value="60")
        dur_entry = tk.Entry(dur_frame, textvariable=dur_var,
                             font=("맑은 고딕", 10), relief="solid", bd=1, width=10)
        dur_entry.pack(side="left", ipady=4)
 
        def apply_recommended():
            name = sel_subject_var.get()
            sc = next((s for s in scores if s["name"] == name), None)
            if sc:
                weekly_h = 20
                rec_min = round((sc["percentage"] / 100) * weekly_h * 60)
                dur_var.set(str(rec_min))
 
        tk.Button(dur_frame, text="추천값 적용", font=("맑은 고딕", 9),
                  bg="#e0e7ff", fg="#4f46e5", relief="flat",
                  cursor="hand2", command=apply_recommended
                  ).pack(side="left", padx=8, ipady=4)
 
        # 추가/취소
        btn_row = tk.Frame(form, bg="#f9fafb")
        btn_row.pack(fill="x", padx=12, pady=(0, 10))
 
        def confirm_add():
            name = sel_subject_var.get()
            dur  = dur_var.get()
            if not name or not dur:
                return
            sc = next((s for s in scores if s["name"] == name), None)
            study_sessions.append({
                "id": str(datetime.now().timestamp()),
                "subjectName": name,
                "duration": int(dur),
                "date": ds,
                "color": sc["color"] if sc else "#3b82f6",
            })
            render_calendar()
            render_session_detail()
 
        tk.Button(btn_row, text="추가", font=("맑은 고딕", 10, "bold"),
                  bg="#4f46e5", fg="white", relief="flat",
                  cursor="hand2", command=confirm_add
                  ).pack(side="left", fill="x", expand=True, ipady=6, padx=(0, 4))
 
        tk.Button(btn_row, text="취소", font=("맑은 고딕", 10),
                  bg="#e5e7eb", fg="#374151", relief="flat",
                  cursor="hand2",
                  command=lambda: add_session_frame.pack_forget()
                  ).pack(side="left", fill="x", expand=True, ipady=6)
 
    tk.Button(session_detail_frame, text="+ 학습 계획 추가",
              font=("맑은 고딕", 10), bg="white", fg="#4f46e5",
              relief="solid", bd=1, cursor="hand2",
              command=show_add_form
              ).pack(fill="x", pady=(4, 0))
 
