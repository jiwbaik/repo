                    font=("맑은 고딕", 10, "bold"),
                    bg="#2563eb", fg="white", relief="flat",
                    activebackground="#1d4ed8", cursor="hand2",
                    command=add_subject, padx=12, pady=6)
add_btn.pack(side="left")
 
# ───────────────────────────────────────────────
# 우선순위 계산 버튼 액션
# ───────────────────────────────────────────────
def calculate_priorities():
    if not subjects:
        messagebox.showwarning("알림", "과목을 먼저 추가해주세요!")
        return
 
    calculated = []
    for i, s in enumerate(subjects):
        score = BASE_SCORE
        if "수학" in s["name"]:
            score += MATH_BONUS
        if s["isWeak"]:
            score += WEAK_WEIGHT
        if s["isFocus"]:
            score += FOCUS_WEIGHT
        score += s["customWeight"]
        calculated.append({
            "name": s["name"],
            "score": score,
            "percentage": 0,
            "color": COLORS[i % len(COLORS)],
        })
 
    total = sum(c["score"] for c in calculated)
    scores.clear()
    for c in calculated:
        c["percentage"] = (c["score"] / total) * 100
        scores.append(c)
 
    render_scores()
    messagebox.showinfo("완료", "우선순위 계산이 완료되었습니다! ✅")
 
calc_btn.config(command=calculate_priorities)
 
