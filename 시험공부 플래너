def render_subjects():
    for w in subject_inner.winfo_children():
        w.destroy()
 
    if not subjects:
        tk.Label(subject_inner, text="📖 과목을 추가해주세요",
                 font=("맑은 고딕", 11), bg="white", fg="#9ca3af"
                 ).pack(pady=40)
        return
 
    for s in subjects:
        card = tk.Frame(subject_inner, bg="white",
                        highlightthickness=1, highlightbackground="#e5e7eb")
        card.pack(fill="x", pady=4)
 
        top = tk.Frame(card, bg="white")
        top.pack(fill="x", padx=10, pady=(8, 4))
        tk.Label(top, text=s["name"], font=("맑은 고딕", 11, "bold"),
                 bg="white", fg="#1f2937").pack(side="left")
 
        def make_remove(sid=s["id"]):
            def remove():
                subjects[:] = [x for x in subjects if x["id"] != sid]
                render_subjects()
            return remove
 
        tk.Button(top, text="🗑", font=("맑은 고딕", 10),
                  bg="white", fg="#ef4444", relief="flat",
                  cursor="hand2", command=make_remove()
                  ).pack(side="right")
 
        checks = tk.Frame(card, bg="white")
        checks.pack(fill="x", padx=10, pady=(0, 4))
 
        weak_var = tk.BooleanVar(value=s["isWeak"])
        focus_var = tk.BooleanVar(value=s["isFocus"])
 
        def make_toggle_weak(sid=s["id"], var=weak_var):
            def toggle():
                for x in subjects:
                    if x["id"] == sid:
                        x["isWeak"] = var.get()
            return toggle
 
        def make_toggle_focus(sid=s["id"], var=focus_var):
            def toggle():
                for x in subjects:
                    if x["id"] == sid:
                        x["isFocus"] = var.get()
            return toggle
 
        tk.Checkbutton(checks, text=f"⚠ 취약 과목 (+{WEAK_WEIGHT}점)",
                       variable=weak_var, command=make_toggle_weak(),
                       font=("맑은 고딕", 9), bg="white", fg="#ef4444",
                       activebackground="white", selectcolor="white"
                       ).pack(side="left", padx=(0, 12))
 
        tk.Checkbutton(checks, text=f"🎯 집중 관리 (+{FOCUS_WEIGHT}점)",
                       variable=focus_var, command=make_toggle_focus(),
                       font=("맑은 고딕", 9), bg="white", fg="#10b981",
                       activebackground="white", selectcolor="white"
                       ).pack(side="left")
 
        # 사용자 지정 가중치
        wt_row = tk.Frame(card, bg="white")
        wt_row.pack(fill="x", padx=10, pady=(0, 8))
        tk.Label(wt_row, text="사용자 가중치:",
                 font=("맑은 고딕", 9), bg="white", fg="#6b7280").pack(side="left")
 
        cw_var = tk.StringVar(value=str(s["customWeight"]))
        cw_entry = tk.Entry(wt_row, textvariable=cw_var, width=5,
                            font=("맑은 고딕", 9), relief="solid", bd=1)
        cw_entry.pack(side="left", padx=4, ipady=2)
        tk.Label(wt_row, text="점 (0-20)",
                 font=("맑은 고딕", 9), bg="white", fg="#9ca3af").pack(side="left")
 
        def make_update_weight(sid=s["id"], var=cw_var):
            def update(e=None):
                try:
                    val = max(0, min(20, int(var.get())))
                except ValueError:
                    val = 0
                for x in subjects:
                    if x["id"] == sid:
                        x["customWeight"] = val
            return update
 
        cw_entry.bind("<FocusOut>", make_update_weight())
        cw_entry.bind("<Return>",   make_update_weight())
 
