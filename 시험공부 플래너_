function ManagePanel({ subjects, setSubjects, scores, setScores }) {
  const [newSubjectName, setNewSubjectName] = useState('');

  const addSubject = () => {
    if (newSubjectName.trim()) {
      setSubjects([...subjects, {
        id: Date.now().toString(),
        name: newSubjectName.trim(),
        isWeak: false,
        isFocus: false,
        customWeight: 0,
      }]);
      setNewSubjectName('');
    }
  };
  const removeSubject = (id) => setSubjects(subjects.filter(s => s.id !== id));
  const toggleWeak = (id) => setSubjects(subjects.map(s => s.id === id ? { ...s, isWeak: !s.isWeak } : s));
  const toggleFocus = (id) => setSubjects(subjects.map(s => s.id === id ? { ...s, isFocus: !s.isFocus } : s));
  const updateCustomWeight = (id, w) => setSubjects(subjects.map(s => s.id === id ? { ...s, customWeight: Math.max(0, w) } : s));

  const calculatePriorities = () => {
    if (subjects.length === 0) return;
    const calc = subjects.map((subject, index) => {
      let score = BASE_SCORE;
      if (subject.name.includes('수학')) score += MATH_BONUS;
      if (subject.isWeak) score += WEAK_WEIGHT;
      if (subject.isFocus) score += FOCUS_WEIGHT;
      score += subject.customWeight;
      return { name: subject.name, score, percentage: 0, color: COLORS[index % COLORS.length] };
    });
    const total = calc.reduce((sum, s) => sum + s.score, 0);
    setScores(calc.map(s => ({ ...s, percentage: (s.score / total) * 100 })));
  };

  const handleKeyPress = (e) => { if (e.key === 'Enter') addSubject(); };

  return (
    <div style={{ display: 'grid', gridTemplateColumns: '1fr', gap: 24 }}>
      <div className="plnr-card">
        <div className="plnr-card-header"><BookOpen size={18} /> 과목 관리</div>

        <div className="plnr-input-row">
          <input
            type="text"
            value={newSubjectName}
            onChange={(e) => setNewSubjectName(e.target.value)}
            onKeyPress={handleKeyPress}
            placeholder="과목명 입력 (예: 수학, 영어)"
            className="plnr-input"
          />
          <button onClick={addSubject} className="plnr-btn-primary">
            <Plus size={16} /> 추가
          </button>
        </div>

        {subjects.length === 0 ? (
          <div className="plnr-empty">
            <span className="plnr-empty-emoji">📖</span>
            <p>과목을 추가해주세요</p>
          </div>
        ) : (
          subjects.map((subject) => (
            <div key={subject.id} className="plnr-subject-item">
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 10 }}>
                <span className="plnr-subject-name">{subject.name}</span>
                <button onClick={() => removeSubject(subject.id)} style={{ background: 'none', border: 'none', cursor: 'pointer', color: 'var(--muted)' }}>
                  <Trash2 size={16} />
                </button>
              </div>
              <div className="plnr-pill-row">
                <div className={`plnr-pill plnr-pill-weak ${subject.isWeak ? 'active' : ''}`} onClick={() => toggleWeak(subject.id)}>
                  <AlertCircle size={13} /> 취약 과목 (+{WEAK_WEIGHT})
                </div>
                <div className={`plnr-pill plnr-pill-focus ${subject.isFocus ? 'active' : ''}`} onClick={() => toggleFocus(subject.id)}>
                  <Target size={13} /> 집중 관리 (+{FOCUS_WEIGHT})
                </div>
              </div>
              <div className="plnr-weight-row">
                <span>사용자 지정 가중치:</span>
                <input
                  type="number"
                  value={subject.customWeight || 0}
                  onChange={(e) => updateCustomWeight(subject.id, parseInt(e.target.value) || 0)}
                  min="0" max="20"
                  className="plnr-weight-input"
                />
                <span>점 (0-20)</span>
              </div>
            </div>
          ))
        )}

        {subjects.length > 0 && (
          <button onClick={calculatePriorities} className="plnr-btn-primary full" style={{ marginTop: 8 }}>
            우선순위 계산하기
          </button>
        )}
      </div>

      <div className="plnr-card">
        <div className="plnr-card-header"><Target size={18} /> 학습 추천 비율</div>

        {scores.length === 0 ? (
          <div className="plnr-empty">
            <span className="plnr-empty-emoji">🎯</span>
            <p>우선순위를 계산해주세요</p>
          </div>
        ) : (
          <>
            <div style={{ marginBottom: 20 }}>
              <ResponsiveContainer width="100%" height={280}>
                <PieChart>
                  <Pie
                    data={scores}
                    cx="50%" cy="50%"
                    labelLine={false}
                    label={({ name, percentage }) => `${name}: ${percentage.toFixed(1)}%`}
                    outerRadius={95}
                    dataKey="percentage"
                  >
                    {scores.map((entry, index) => <Cell key={`cell-${index}`} fill={entry.color} />)}
                  </Pie>
                  <Tooltip formatter={(value) => `${value.toFixed(1)}%`} />
                </PieChart>
              </ResponsiveContainer>
            </div>

            <div>
              {scores.map((subject, index) => (
                <div key={index} style={{ borderLeft: `4px solid ${subject.color}`, paddingLeft: 14, paddingTop: 6, paddingBottom: 6, marginBottom: 12 }}>
                  <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 6 }}>
                    <span className="plnr-subject-name" style={{ fontSize: 14 }}>{subject.name}</span>
                    <span style={{ fontSize: 13, fontWeight: 700, color: 'var(--muted)' }}>{subject.percentage.toFixed(1)}%</span>
                  </div>
                  <div className="plnr-progress-track">
                    <div className="plnr-progress-fill" style={{ width: `${subject.percentage}%`, backgroundColor: subject.color }} />
                  </div>
                  <div style={{ fontSize: 11, color: 'var(--muted)', marginTop: 4 }}>우선순위 점수: {subject.score}점</div>
                </div>
              ))}
            </div>

            <div className="plnr-info-box">
              <strong>점수 계산 방식</strong><br />
              · 기본 점수: {BASE_SCORE}점 · 수학 보너스: +{MATH_BONUS}점<br />
              · 취약 과목: +{WEAK_WEIGHT}점 · 집중 관리: +{FOCUS_WEIGHT}점<br />
              · 사용자 지정 가중치: 0~20점
            </div>
          </>
        )}
      </div>
    </div>
  );
}

function toDateInputValue(date) {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, '0');
  const d = String(date.getDate()).padStart(2, '0');
  return `${y}-${m}-${d}`;
}

function CalendarPanel({ subjects, scores }) {
  const [currentDate, setCurrentDate] = useState(new Date());
  const [selectedDate, setSelectedDate] = useState(null);
  const [studySessions, setStudySessions] = useState([]);

  const [examDate, setExamDate] = useState('');
  const [weekdayHours, setWeekdayHours] = useState([4, 2, 2, 2, 2, 2, 4]);
  const [isSetupOpen, setIsSetupOpen] = useState(true);
  const [showGuide, setShowGuide] = useState(true);
  const [showBreakdown, setShowBreakdown] = useState(false);
  const [planTotalHours, setPlanTotalHours] = useState(0);

  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const examDateObj = examDate ? new Date(examDate + 'T00:00:00') : null;
  const hasPlan = !!examDateObj && examDateObj > today;

  const getStudyDays = () => {
    if (!examDateObj) return [];
    const list = [];
    const cur = new Date(today);
    while (cur < examDateObj) {
      list.push(new Date(cur));
      cur.setDate(cur.getDate() + 1);
    }
    return list;
  };
  const studyDays = hasPlan ? getStudyDays() : [];
  const totalAvailableHours = studyDays.reduce((sum, d) => sum + (weekdayHours[d.getDay()] || 0), 0);
  const daysUntilExam = examDateObj ? Math.ceil((examDateObj.getTime() - today.getTime()) / 86400000) : 0;

  const isStudyDay = (date) => hasPlan && date && date >= today && date < examDateObj;
  const isExamDay = (date) => hasPlan && date && isSameDay(date, examDateObj);

  const loggedMinutesBySubject = useMemo(() => {
    const map = {};
    studySessions.forEach(s => { map[s.subjectName] = (map[s.subjectName] || 0) + s.duration; });
    return map;
  }, [studySessions]);

  const subjectStats = useMemo(() => {
    if (!hasPlan || scores.length === 0) return [];
    return scores.map(s => {
      const targetHours = (s.percentage / 100) * planTotalHours;
      const loggedHours = (loggedMinutesBySubject[s.name] || 0) / 60;
      const remainingNeed = Math.max(0, targetHours - loggedHours);
      return { name: s.name, color: s.color, percentage: s.percentage, targetHours, loggedHours, remainingNeed };
    });
  }, [hasPlan, scores, planTotalHours, loggedMinutesBySubject]);

  const adjustedWeights = useMemo(() => {
    if (subjectStats.length === 0) return [];
    const needSum = subjectStats.reduce((sum, s) => sum + s.remainingNeed, 0);
    if (needSum <= 0) return subjectStats.map(s => ({ name: s.name, color: s.color, weight: s.percentage / 100 }));
    return subjectStats.map(s => ({ name: s.name, color: s.color, weight: s.remainingNeed / needSum }));
  }, [subjectStats]);

  const dailyPlan = useMemo(() => {
    const map = {};
    const active = adjustedWeights.filter(w => w.weight > 0);
    if (!hasPlan || active.length === 0 || studyDays.length === 0) return map;
    const subjectsPerDay = Math.max(1, Math.ceil(active.length / 2));
    const credits = {};
    active.forEach(w => { credits[w.name] = 0; });
    studyDays.forEach(day => {
      active.forEach(w => { credits[w.name] += w.weight; });
      const ranked = [...active].sort((a, b) => credits[b.name] - credits[a.name]);
      const chosen = ranked.slice(0, subjectsPerDay);
      const chosenWeightSum = chosen.reduce((sum, c) => sum + c.weight, 0) || 1;
      chosen.forEach(c => { credits[c.name] -= chosenWeightSum / chosen.length; });
      const dayMinutes = (weekdayHours[day.getDay()] || 0) * 60;
      map[toDateInputValue(day)] = chosen.map(c => ({
        name: c.name, color: c.color,
        minutes: Math.round(dayMinutes * (c.weight / chosenWeightSum)),
      }));
    });
    return map;
  }, [hasPlan, adjustedWeights, studyDays, weekdayHours]);

  const getDailyPlanForDate = (date) => date ? (dailyPlan[toDateInputValue(date)] || []) : [];
  const getDailyRecommendedMinutes = (date, name) => {
    const found = getDailyPlanForDate(date).find(e => e.name === name);
    return found ? found.minutes : 0;
  };
  const getDailyTotalHours = (date) => (hasPlan && date) ? (weekdayHours[date.getDay()] || 0) : 0;

  const getDaysInMonth = (date) => {
    const year = date.getFullYear(), month = date.getMonth();
    const firstDay = new Date(year, month, 1);
    const lastDay = new Date(year, month + 1, 0);
    const days = [];
    for (let i = 0; i < firstDay.getDay(); i++) days.push(null);
    for (let i = 1; i <= lastDay.getDate(); i++) days.push(new Date(year, month, i));
    return days;
  };

  const getSessionsForDate = (date) => date ? studySessions.filter(s => isSameDay(s.date, date)) : [];
  const getTotalHoursForDate = (date) => getSessionsForDate(date).reduce((sum, s) => sum + s.duration, 0) / 60;
  const removeSession = (id) => setStudySessions(studySessions.filter(s => s.id !== id));

  const getTodayStats = () => {
    return subjects.map(subject => {
      const totalMinutes = studySessions
        .filter(s => s.subjectName === subject.name && isSameDay(s.date, today))
        .reduce((sum, s) => sum + s.duration, 0);
      const recommendedMinutes = getDailyRecommendedMinutes(today, subject.name);
      return { name: subject.name, hours: totalMinutes / 60, recommendedHours: recommendedMinutes / 60 };
    }).filter(s => s.hours > 0 || s.recommendedHours > 0);
  };

  const days = getDaysInMonth(currentDate);
  const todayStats = hasPlan ? getTodayStats() : [];
  const previousMonth = () => setCurrentDate(new Date(currentDate.getFullYear(), currentDate.getMonth() - 1, 1));
  const nextMonth = () => setCurrentDate(new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 1));

  const updateWeekdayHour = (idx, val) => {
    const next = [...weekdayHours];
    next[idx] = Math.max(0, parseFloat(val) || 0);
    setWeekdayHours(next);
  };

  const confirmSetup = () => {
    if (!examDate || scores.length === 0) return;
    const total = getStudyDays().reduce((sum, d) => sum + (weekdayHours[d.getDay()] || 0), 0);
    setPlanTotalHours(total);
    setIsSetupOpen(false);
    setShowGuide(false);
  };

  // ── 타이머: Date.now() 기반으로 경과시간 계산 ──
  const [timerSubject, setTimerSubject] = useState('');
  const [timerSeconds, setTimerSeconds] = useState(0);
  const [timerRunning, setTimerRunning] = useState(false);
  const [toast, setToast] = useState(null);
  const startTimestampRef = useRef(null);
  const timerIntervalRef = useRef(null);
  const toastTimerRef = useRef(null);

  useEffect(() => {
    if (timerRunning) {
      startTimestampRef.current = Date.now();
      timerIntervalRef.current = setInterval(() => {
        setTimerSeconds(Math.floor((Date.now() - startTimestampRef.current!) / 1000));
      }, 500);
    } else {
      if (timerIntervalRef.current) clearInterval(timerIntervalRef.current);
    }
    return () => { if (timerIntervalRef.current) clearInterval(timerIntervalRef.current); };
  }, [timerRunning]);

  // 탭이 백그라운드로 전환될 때 자동저장하고 정지
  useEffect(() => {
    const handleVisibility = () => {
      if (document.hidden && timerRunning) {
        const elapsed = startTimestampRef.current ? Math.floor((Date.now() - startTimestampRef.current) / 1000) : timerSeconds;
        commitSession(timerSubject, elapsed);
        setTimerRunning(false);
        setTimerSeconds(0);
        setTimerSubject('');
      }
    };
    document.addEventListener('visibilitychange', handleVisibility);
    return () => document.removeEventListener('visibilitychange', handleVisibility);
  }, [timerRunning, timerSubject, timerSeconds]);

  const showToast = (msg) => {
    setToast(msg);
    if (toastTimerRef.current) clearTimeout(toastTimerRef.current);
    toastTimerRef.current = setTimeout(() => setToast(null), 2400);
  };

  const formatTimer = (totalSeconds) => {
    const h = Math.floor(totalSeconds / 3600);
    const m = Math.floor((totalSeconds % 3600) / 60);
    const s = totalSeconds % 60;
    const pad = (n) => String(n).padStart(2, '0');
    return h > 0 ? `${pad(h)}:${pad(m)}:${pad(s)}` : `${pad(m)}:${pad(s)}`;
  };

  const commitSession = (subject, seconds) => {
    if (!subject || seconds < 10) return;
    const scoreData = scores.find(s => s.name === subject);
    const minutes = Math.max(1, Math.round(seconds / 60));
    const saveDate = new Date(today);
    setStudySessions(prev => [...prev, {
      id: Date.now().toString(),
      subjectName: subject,
      duration: minutes,
      date: saveDate,
      color: scoreData?.color || '#1a2744',
    }]);
    showToast(`✓ ${subject} ${minutes}분 기록됐어요`);
  };

  const startTimer = () => { if (timerSubject) setTimerRunning(true); };

  const stopTimer = () => {
    const elapsed = startTimestampRef.current ? Math.floor((Date.now() - startTimestampRef.current) / 1000) : timerSeconds;
    setTimerRunning(false);
    commitSession(timerSubject, elapsed);
    setTimerSeconds(0);
    setTimerSubject('');
  };

  const resetTimer = () => {
    setTimerRunning(false);
    setTimerSeconds(0);
    setTimerSubject('');
  };

  // 과목 전환: 현재 시간 저장 후 새 과목으로 즉시 시작
  const switchSubject = (newSubject) => {
    if (newSubject === timerSubject) return;
    const elapsed = startTimestampRef.current ? Math.floor((Date.now() - startTimestampRef.current) / 1000) : timerSeconds;
    commitSession(timerSubject, elapsed);
    setTimerSeconds(0);
    setTimerSubject(newSubject);
    // startTimestampRef는 timerRunning이 유지되므로 다음 interval tick에서 재설정됨
    startTimestampRef.current = Date.now();
  };

  const todayLoggedMinutes = useMemo(() => {
    return studySessions.filter(s => isSameDay(s.date, today)).reduce((sum, s) => sum + s.duration, 0);
  }, [studySessions]);

  const minSelectableDate = toDateInputValue(new Date(today.getTime() + 86400000));

  return (
    <div className="plnr-card">
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 16, flexWrap: 'wrap', gap: 8 }}>
        <div className="plnr-card-header" style={{ marginBottom: 0, border: 'none', paddingBottom: 0 }}>
          <CalendarIcon size={18} /> 학습 계획 달력
        </div>
        <div style={{ display: 'flex', alignItems: 'center', gap: 14 }}>
          <button onClick={() => setShowGuide(!showGuide)} className="plnr-guide-link">
            {showGuide ? '이용 방법 숨기기' : '❔ 이용 방법'}
          </button>
          {hasPlan && !isSetupOpen && (
            <button onClick={() => setIsSetupOpen(true)} className="plnr-btn-gold">시험 설정 변경</button>
          )}
        </div>
      </div>

      <div className="plnr-timer-card">
        <div className="plnr-timer-inner">
          <div className="plnr-timer-title">
            {timerRunning && <span className="plnr-timer-live-dot" />}
            {timerRunning ? `${timerSubject} 공부 중` : '학습 타이머'}
          </div>

          {!timerRunning && (
            <select
              value={timerSubject}
              onChange={(e) => setTimerSubject(e.target.value)}
              className="plnr-timer-select"
            >
              <option value="">과목을 선택하세요</option>
              {subjects.map(subject => <option key={subject.id} value={subject.name}>{subject.name}</option>)}
            </select>
          )}

          <div className="plnr-timer-display">{formatTimer(timerSeconds)}</div>

          {timerSubject && hasPlan && isStudyDay(today) && (
            <div className="plnr-timer-rec">
              오늘 '{timerSubject}' 추천: {getDailyRecommendedMinutes(today, timerSubject) > 0 ? `${getDailyRecommendedMinutes(today, timerSubject)}분` : '오늘은 다른 과목 위주 추천'}
            </div>
          )}

          <div className="plnr-timer-btns">
            {!timerRunning && (
              <button onClick={startTimer} disabled={!timerSubject} className="plnr-timer-btn start">▶ 시작</button>
            )}
            {timerRunning && (
              <button onClick={stopTimer} className="plnr-timer-btn stop">■ 종료 · 기록</button>
            )}
            {timerRunning && (
              <button onClick={resetTimer} className="plnr-timer-btn reset">초기화</button>
            )}
          </div>

          {timerRunning && subjects.length > 1 && (
            <div className="plnr-switch-row">
              <div style={{ width: '100%', textAlign: 'center' }}>
                <div className="plnr-switch-label">과목 전환 (현재 시간 자동 저장)</div>
                <div style={{ display: 'flex', gap: 8, justifyContent: 'center', flexWrap: 'wrap' }}>
                  {subjects.map(s => (
                    <button
                      key={s.id}
                      onClick={() => switchSubject(s.name)}
                      className={`plnr-switch-chip ${s.name === timerSubject ? 'active' : ''}`}
                    >
                      {s.name}
                    </button>
                  ))}
                </div>
              </div>
            </div>
          )}

          <div className="plnr-timer-today">
            오늘 누적 학습 기록 <strong>{Math.floor(todayLoggedMinutes / 60)}시간 {todayLoggedMinutes % 60}분</strong>
            {timerRunning && <span> (+ 진행 중)</span>}
          </div>
        </div>
      </div>

      {toast && <div className="plnr-toast">{toast}</div>}

      {showGuide && (
        <div className="plnr-guide-card">
          <div className="plnr-guide-title">💡 이렇게 사용해보세요</div>
          <div className="plnr-guide-step">
            <span className="plnr-guide-num">1</span>
            <span>'과목관리' 탭에서 과목을 추가하고 취약·집중 과목을 표시한 뒤 <strong>우선순위 계산하기</strong>를 눌러주세요.</span>
          </div>
          <div className="plnr-guide-step">
            <span className="plnr-guide-num">2</span>
            <span>아래에서 <strong>시험 날짜</strong>와 <strong>요일별로 공부 가능한 시간</strong>을 입력해주세요.</span>
          </div>
          <div className="plnr-guide-step">
            <span className="plnr-guide-num">3</span>
            <span>타이머로 공부하면 자동 기록돼요. 과목 전환 버튼으로 중간에 바꿀 수도 있어요.</span>
          </div>
          <div className="plnr-guide-step">
            <span className="plnr-guide-num">4</span>
            <span>탭을 벗어나면 그 시점까지 공부한 시간이 자동으로 저장돼요.</span>
          </div>
          <div className="plnr-guide-step">
            <span className="plnr-guide-num">5</span>
            <span>계획보다 밀린 과목이 생기면, 남은 기간 동안 그 과목에 자동으로 더 많은 시간이 배정돼요.</span>
          </div>
        </div>
      )}

      {isSetupOpen ? (
        <div className="plnr-add-panel" style={{ marginBottom: 24 }}>
          <div className="plnr-setup-row">
            <label className="plnr-setup-label">시험 날짜</label>
            <input
              type="date"
              value={examDate}
              min={minSelectableDate}
              onChange={(e) => setExamDate(e.target.value)}
              className="plnr-input"
              style={{ width: '100%' }}
            />
          </div>
          <div className="plnr-setup-row" style={{ marginBottom: 8 }}>
            <label className="plnr-setup-label">요일별 공부 가능 시간</label>
            <div className="plnr-weekday-grid">
              {WEEKDAYS.map((wd, idx) => (
                <div key={wd} className={`plnr-weekday-input-item ${(idx === 0 || idx === 6) ? 'weekend' : ''}`}>
                  <label>{wd}</label>
                  <input
                    type="number" min="0" max="24" step="0.5"
                    value={weekdayHours[idx]}
                    onChange={(e) => updateWeekdayHour(idx, e.target.value)}
                  />
                  <div className="plnr-weekday-unit">시간</div>
                </div>
              ))}
            </div>
          </div>
          {scores.length === 0 && (
            <div className="plnr-info-box">⚠️ 먼저 '과목관리' 탭에서 과목을 추가하고 우선순위를 계산해주세요.</div>
          )}
          <button onClick={confirmSetup} disabled={!examDate || scores.length === 0} className="plnr-btn-primary full" style={{ marginTop: 20 }}>
            학습 계획 만들기
          </button>
        </div>
      ) : (
        hasPlan && (
          <>
            <div className="plnr-dday-banner">
              <div className="plnr-dday-main">
                <span className="plnr-dday-num">D-{daysUntilExam}</span>
                <span className="plnr-dday-label">{formatDate(examDateObj)} 시험까지</span>
              </div>
              <div className="plnr-dday-total">
                남은 공부 가능 시간<br /><strong>{totalAvailableHours.toFixed(1)}시간</strong>
              </div>
            </div>
            <button onClick={() => setShowBreakdown(!showBreakdown)} className="plnr-btn-gold" style={{ marginBottom: 16 }}>
              {showBreakdown ? '과목별 배분 숨기기' : '과목별 배분 보기'}
            </button>
            {showBreakdown && (
              <div style={{ background: 'var(--cream-mid)', borderRadius: 12, padding: 16, marginBottom: 20 }}>
                {subjectStats.map((s, index) => (
                  <div key={index} className="plnr-rec-swatch-row">
                    <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
                      <div style={{ width: 10, height: 10, borderRadius: '50%', backgroundColor: s.color }} />
                      <span style={{ fontWeight: 600 }}>{s.name}</span>
                    </div>
                    <span style={{ color: 'var(--muted)' }}>
                      {s.loggedHours.toFixed(1)}h / {s.targetHours.toFixed(1)}h
                      {s.remainingNeed > 0
                        ? <span style={{ color: 'var(--gold)', marginLeft: 6, fontWeight: 700 }}>(밀림 {s.remainingNeed.toFixed(1)}h)</span>
                        : <span style={{ color: 'var(--navy-light)', marginLeft: 6, fontWeight: 700 }}>✓ 완료</span>}
                    </span>
                  </div>
                ))}
                <div style={{ fontSize: 11, color: 'var(--muted)', marginTop: 10, lineHeight: 1.6 }}>
                  💡 계획보다 밀린 과목은 남은 기간에 자동으로 더 많은 시간이 배정돼요.
                </div>
              </div>
            )}
          </>
        )
      )}

      <div className="plnr-cal-controls">
        <button onClick={previousMonth} className="plnr-cal-nav-btn">←</button>
        <span className="plnr-cal-month">{currentDate.getFullYear()}년 {currentDate.getMonth() + 1}월</span>
        <button onClick={nextMonth} className="plnr-cal-nav-btn">→</button>
      </div>

      <div className="plnr-weekday-row">
        {WEEKDAYS.map(day => <div key={day} className="plnr-weekday-label">{day}</div>)}
      </div>
      <div className="plnr-day-grid">
        {days.map((day, index) => {
          const sessions = getSessionsForDate(day);
          const totalHours = getTotalHoursForDate(day);
          const isSelected = day && selectedDate && isSameDay(day, selectedDate);
          const isToday = day && isSameDay(day, new Date());
          const studyDay = isStudyDay(day);
          const examDay = isExamDay(day);
          const outside = hasPlan && day && !studyDay && !examDay;
          return (
            <div
              key={index}
              onClick={() => day && setSelectedDate(day)}
              className={`plnr-day-cell ${!day ? 'empty' : ''} ${isSelected ? 'selected' : ''} ${isToday ? 'today' : ''} ${examDay ? 'exam' : ''} ${outside ? 'outside' : ''}`}
            >
              {day && (
                <>
                  <div className={`plnr-day-num ${isToday ? 'today' : ''}`}>{day.getDate()}</div>
                  {examDay && <div className="plnr-exam-flag">🎯 시험일</div>}
                  {studyDay && getDailyPlanForDate(day).length > 0 && (
                    <div className="plnr-rec-strip">
                      {getDailyPlanForDate(day).map((e, i) => <div key={i} style={{ flexGrow: e.minutes || 1, backgroundColor: e.color }} />)}
                    </div>
                  )}
                  {sessions.length > 0 && (
                    <div style={{ marginTop: 4 }}>
                      {sessions.slice(0, 2).map(session => (
                        <div key={session.id} className="plnr-session-tag" style={{ backgroundColor: session.color + '1f', color: session.color }}>
                          {session.subjectName}
                        </div>
                      ))}
                      {sessions.length > 2 && <div style={{ fontSize: 10, color: 'var(--muted)' }}>+{sessions.length - 2}</div>}
                      <div style={{ fontSize: 10, fontWeight: 700, color: 'var(--muted)', display: 'flex', alignItems: 'center', gap: 3, marginTop: 2 }}>
                        <Clock size={10} /> {totalHours.toFixed(1)}h
                      </div>
                    </div>
                  )}
                </>
              )}
            </div>
          );
        })}
      </div>

      {selectedDate && (
        <div>
          <div className="plnr-detail-header">{formatDate(selectedDate)}</div>

          {isStudyDay(selectedDate) && getDailyPlanForDate(selectedDate).length > 0 && (
            <div style={{ background: 'var(--cream-mid)', borderRadius: 10, padding: 14, marginBottom: 14 }}>
              <div style={{ fontWeight: 700, color: 'var(--navy)', marginBottom: 8, fontSize: 13 }}>
                이 날 추천 학습 배분 (총 {getDailyTotalHours(selectedDate).toFixed(1)}시간)
              </div>
              {getDailyPlanForDate(selectedDate).map((e, i) => (
                <div key={i} style={{ display: 'flex', justifyContent: 'space-between', fontSize: 12.5, marginBottom: 4 }}>
                  <span style={{ display: 'flex', alignItems: 'center', gap: 6 }}>
                    <span style={{ width: 8, height: 8, borderRadius: '50%', backgroundColor: e.color, display: 'inline-block' }} />
                    {e.name}
                  </span>
                  <span style={{ color: 'var(--muted)' }}>{e.minutes}분</span>
                </div>
              ))}
              <div style={{ fontSize: 11, color: 'var(--muted)', marginTop: 8 }}>오늘은 이 과목들에 집중하는 날이에요. 나머지 과목은 다른 날 배정돼요.</div>
            </div>
          )}

          {isExamDay(selectedDate) && (
            <div className="plnr-info-box">🎯 시험 날이에요! 무리한 학습보다는 가벼운 마무리 점검을 추천해요.</div>
          )}

          {getSessionsForDate(selectedDate).map(session => (
            <div key={session.id} className="plnr-session-row" style={{ backgroundColor: session.color + '12' }}>
              <div style={{ display: 'flex', alignItems: 'center', gap: 10 }}>
                <div style={{ width: 10, height: 10, borderRadius: '50%', backgroundColor: session.color }} />
                <span style={{ fontWeight: 600 }}>{session.subjectName}</span>
                <span style={{ fontSize: 13, color: 'var(--muted)' }}>{session.duration}분</span>
              </div>
              <button onClick={() => removeSession(session.id)} style={{ background: 'none', border: 'none', cursor: 'pointer', color: 'var(--muted)' }}>
                <X size={16} />
              </button>
            </div>
          ))}

          {getSessionsForDate(selectedDate).length === 0 && (
            <div style={{ fontSize: 12, color: 'var(--muted)', padding: '12px 0' }}>이 날 기록된 학습이 없어요. 타이머로 공부하면 자동으로 여기에 쌓여요.</div>
          )}
        </div>
      )}

      {hasPlan && todayStats.length > 0 && (
        <div style={{ marginTop: 24, paddingTop: 20, borderTop: '2px solid var(--cream-dark)' }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: 8, fontFamily: "'Noto Serif KR', serif", fontWeight: 700, color: 'var(--navy)', marginBottom: 14 }}>
            <TrendingUp size={17} /> 오늘 하루 달성도
          </div>
          {todayStats.map((stat, index) => {
            const recommended = stat.recommendedHours;
            const percentage = recommended > 0 ? (stat.hours / recommended) * 100 : (stat.hours > 0 ? 100 : 0);
            return (
              <div key={index} className="plnr-weekly-row">
                <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: 13, marginBottom: 6 }}>
                  <span style={{ fontWeight: 600 }}>{stat.name}</span>
                  <span style={{ color: 'var(--muted)' }}>
                    {stat.hours.toFixed(1)}h / {recommended.toFixed(1)}h
                    <span style={{ marginLeft: 8, color: percentage >= 100 ? 'var(--gold)' : 'var(--navy-light)', fontWeight: 700 }}>
                      ({percentage.toFixed(0)}%)
                    </span>
                  </span>
                </div>
                <div className="plnr-progress-track">
                  <div className="plnr-progress-fill" style={{ width: `${Math.min(percentage, 100)}%`, backgroundColor: percentage >= 100 ? 'var(--gold)' : 'var(--navy-light)' }} />
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  );
}

export default function App() {
  const [subjects, setSubjects] = useState([]);
  const [scores, setScores] = useState([]);
  const [tab, setTab] = useState('manage');

  return (
    <div className="plnr-root">
      <ThemeStyles />

      <div className="plnr-hero">
        <div className="plnr-hero-inner">
          <div className="plnr-badge">STUDY PLANNER</div>
          <h1 className="plnr-title">
            <span className="accent">시험공부</span> 플래너
          </h1>
          <p className="plnr-sub">과목별 우선순위를 정하면<br />너에게 맞는 학습 비율과 계획을 만들어줄게</p>
        </div>
      </div>

      <div className="plnr-container">
        {tab === 'manage'
          ? <ManagePanel subjects={subjects} setSubjects={setSubjects} scores={scores} setScores={setScores} />
          : <CalendarPanel subjects={subjects} scores={scores} />
        }
      </div>

      <div className="plnr-nav">
        <div className={`plnr-nav-item ${tab === 'manage' ? 'active' : ''}`} onClick={() => setTab('manage')}>
          <div className="plnr-nav-emoji">📖</div>
          <div>과목관리</div>
        </div>
        <div className={`plnr-nav-item ${tab === 'calendar' ? 'active' : ''}`} onClick={() => setTab('calendar')}>
          <div className="plnr-nav-emoji">📅</div>
          <div>학습달력</div>
        </div>
      </div>
    </div>
  );
}
